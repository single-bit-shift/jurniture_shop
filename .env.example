# Server configuration
PORT=5000

# MongoDB Connection URI
MONGODB_URI=your_mongodb_connection_string

# JWT Secret Key for token signing
JWT_SECRET=your_jwt_secret_key

# Admin passkey required during admin login / verification
ADMIN_PASSKEY=your_admin_passkey

# Cloudinary credentials for product image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email service configuration (Resend API)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Teak & Timber <onboarding@resend.dev>


# Public business contact details
BUSINESS_PHONE=+919876543210
